# Application
APP_NAME=ThreatHunter
APP_VERSION=1.0.0
DEBUG=True

# Database
DATABASE_URL=sqlite:///./data/database/threathunter.db
# For PostgreSQL: postgresql://user:password@localhost/threathunter

# API
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# File Upload
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
UPLOAD_DIR=./data/uploads

# Processing
MAX_PACKETS_PER_SESSION=1000000
PACKET_PROCESSING_BATCH_SIZE=1000

# Threat Detection Thresholds
PORT_SCAN_THRESHOLD_MEDIUM=20
PORT_SCAN_THRESHOLD_HIGH=50
PORT_SCAN_TIME_WINDOW=60

TRAFFIC_SPIKE_MULTIPLIER=3.0

EXCESSIVE_REQUESTS_MEDIUM=100
EXCESSIVE_REQUESTS_HIGH=500
EXCESSIVE_REQUESTS_TIME_WINDOW=60

# Redis (for background tasks)
REDIS_URL=redis://localhost:6379/0
